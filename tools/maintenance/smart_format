"""Reformat source file headers in src/ and run clang-format.

Workflow:
1. Fix headers: each key-value on its own line, Description wrapped at 80 chars
2. Add temporary clang-format off/on guards around headers
3. Run clang-format — guards protect the headers
4. Strip the temporary guards

By default, only files changed according to git are processed.

Usage:
    smart_format [--check] [--verbose] [--all] [SRC_DIR]

    --check     Report files that need header changes without modifying
    --verbose   Print per-file details during processing
    --very-verbose  Print phase-level progress and per-file details
    --all       Process all source files, not just git-changed ones
    SRC_DIR     Source directory (default: ../../src relative to this script)
"""

import os
import re
import subprocess
import sys

MAX_LINE = 80
EXTENSIONS = {'.c', '.cpp', '.C', '.h', '.hpp', '.H'}
EXCLUDE_DIRS = {'solver'}
KEYS = ['File', 'Created', 'Author', 'Description']
COPYRIGHT_RE = re.compile(
    r'Copyright\s+\d{4}\s+CCFNUM\s+HSLU\s+T&A\.\s+All\s+Rights\s+Reserved\.'
)
GUARD_OFF = '// clang-format off'
GUARD_ON = '// clang-format on'


# ---------------------------------------------------------------------------
# Header collection
# ---------------------------------------------------------------------------

def collect_header(lines):
    """Collect consecutive comment lines from the top of the file.

    Strips any existing ``// clang-format off`` / ``// clang-format on`` guards
    so the script is idempotent.

    Returns (header_lines, rest_start_index).
    """
    header = []
    i = 0

    # Strip UTF-8 BOM if present on first line
    if lines and lines[0].startswith('\ufeff'):
        lines = [lines[0].lstrip('\ufeff')] + lines[1:]

    # Skip leading clang-format off guard
    if i < len(lines) and lines[i].strip() == GUARD_OFF:
        i += 1

    while i < len(lines):
        s = lines[i].strip()
        if s == GUARD_ON:
            i += 1
            break
        if not s.startswith('//'):
            break
        header.append(s)
        i += 1

    return header, i


# ---------------------------------------------------------------------------
# Parsing
# ---------------------------------------------------------------------------

def _strip_prefix(line):
    """Remove ``//`` prefix and optional leading space."""
    if line.startswith('// '):
        return line[3:]
    if line.startswith('//'):
        return line[2:]
    return line


def parse_entries(header_lines):
    """Parse header lines into a list of ``(key, value)`` tuples.

    Handles headers that were mangled by clang-format (keys joined on one line)
    by joining all header text and splitting on known key markers.
    """
    text = ' '.join(_strip_prefix(l).strip() for l in header_lines)
    text = re.sub(r'\s+', ' ', text).strip()
    if not text:
        return []

    # Locate each key in order (search forward only to avoid false matches)
    positions = []
    search_from = 0
    for key in KEYS:
        m = re.search(rf'\b{key}\s*:\s*', text[search_from:])
        if m:
            abs_start = search_from + m.start()
            abs_vstart = search_from + m.end()
            positions.append((key, abs_start, abs_vstart))
            search_from = abs_vstart

    # Copyright marker (no colon, just "Copyright YYYY")
    m = re.search(r'\bCopyright\s+\d{4}', text[search_from:])
    if m:
        abs_start = search_from + m.start()
        positions.append(('_copyright', abs_start, abs_start))

    if not positions:
        return []

    # Extract values
    entries = []
    for idx, (key, _kstart, vstart) in enumerate(positions):
        vend = positions[idx + 1][1] if idx + 1 < len(positions) else len(text)

        if key == '_copyright':
            full = text[_kstart:vend].strip()
            cm = COPYRIGHT_RE.search(full)
            if cm:
                entries.append(('Copyright', full[:cm.end()].strip()))
                extra = full[cm.end():].strip()
                if extra:
                    entries.append(('Extra', extra))
            else:
                entries.append(('Copyright', full))
        else:
            entries.append((key, text[vstart:vend].strip()))

    return entries


# ---------------------------------------------------------------------------
# Formatting
# ---------------------------------------------------------------------------

def _wrap_description(value):
    """Wrap description at 80 chars with aligned continuation lines.

    ``// Description: `` is 16 characters.  Continuation lines use
    ``//              `` (also 16 characters) so text aligns.
    """
    if not value:
        return ['// Description:']

    prefix = '// Description: '   # 16 chars
    cont   = '//              '   # 16 chars
    avail  = MAX_LINE - len(prefix)  # 64

    words = value.split()
    chunks = []
    current = ''

    for word in words:
        if current:
            test = current + ' ' + word
            if len(test) <= avail:
                current = test
            else:
                chunks.append(current)
                current = word
        else:
            current = word

    if current:
        chunks.append(current)

    return [
        (prefix if i == 0 else cont) + chunk
        for i, chunk in enumerate(chunks)
    ] or ['// Description:']


def _format_key(key, value):
    """Format a standard key-value pair with aligned colon."""
    padded = key.ljust(11)
    return f'// {padded}: {value}' if value else f'// {padded}:'


def rebuild_header(entries, with_guards=True):
    """Rebuild formatted header lines, optionally with clang-format guards."""
    lines = []
    if with_guards:
        lines.append(GUARD_OFF)

    for key, value in entries:
        if key == 'Description':
            lines.extend(_wrap_description(value))
        elif key in ('Copyright', 'Extra'):
            lines.append(f'// {value}')
        else:
            lines.append(_format_key(key, value))

    if with_guards:
        lines.append(GUARD_ON)
    return lines


# ---------------------------------------------------------------------------
# File processing
# ---------------------------------------------------------------------------

def _is_header_file(lines):
    """Check if the file starts with a recognisable header."""
    if not lines:
        return False
    first_few = '\n'.join(lines[:6]).lstrip('\ufeff')
    return bool(re.search(r'^//.*\bFile\b', first_few, re.MULTILINE))


def format_header_content(content):
    """Format header and add temporary guards in memory.

    Returns (new_content, changed) where changed indicates whether the
    header was reformatted (ignoring the guards themselves).
    """
    lines = content.splitlines()
    if not _is_header_file(lines):
        return content, False

    header_lines, rest_start = collect_header(lines)
    if not header_lines:
        return content, False

    entries = parse_entries(header_lines)
    if not entries:
        return content, False

    # Check if header changed (without guards, for reporting)
    plain_header = rebuild_header(entries, with_guards=False)
    plain_lines = plain_header + lines[rest_start:]
    plain_content = '\n'.join(plain_lines)
    if content.endswith('\n'):
        plain_content += '\n'
    header_changed = (plain_content != content)

    # Build guarded version for clang-format
    guarded_header = rebuild_header(entries, with_guards=True)
    guarded_lines = guarded_header + lines[rest_start:]
    guarded_content = '\n'.join(guarded_lines)
    if content.endswith('\n'):
        guarded_content += '\n'

    return guarded_content, header_changed


def strip_guards_content(content):
    """Remove clang-format off/on guards around the header in memory."""
    lines = content.splitlines()
    if not lines:
        return content

    new_lines = []
    i = 0

    if lines[i].strip() == GUARD_OFF:
        i += 1

    while i < len(lines):
        s = lines[i].strip()
        if s == GUARD_ON:
            i += 1
            break
        new_lines.append(lines[i])
        i += 1

    new_lines.extend(lines[i:])

    new_content = '\n'.join(new_lines)
    if content.endswith('\n'):
        new_content += '\n'
    return new_content


def find_source_files(src_dir):
    """Return sorted list of all source files under src_dir, excluding EXCLUDE_DIRS."""
    result = []
    for root, dirs, files in os.walk(src_dir):
        # Prune excluded directories (relative to src_dir)
        rel = os.path.relpath(root, src_dir)
        dirs[:] = sorted(d for d in dirs if rel != '.' or d not in EXCLUDE_DIRS)
        for fname in sorted(files):
            ext = os.path.splitext(fname)[1]
            if ext in EXTENSIONS:
                result.append(os.path.join(root, fname))
    return result


def find_changed_source_files(src_dir):
    """Return sorted list of git-changed source files under src_dir, excluding EXCLUDE_DIRS."""
    src_dir_abs = os.path.abspath(src_dir)

    # Find git repo root
    try:
        repo_root = subprocess.check_output(
            ['git', 'rev-parse', '--show-toplevel'],
            text=True, stderr=subprocess.DEVNULL
        ).strip()
    except subprocess.CalledProcessError:
        print('Warning: not a git repository, falling back to all files')
        return find_source_files(src_dir)

    # Get changed files (staged + unstaged vs HEAD)
    try:
        output = subprocess.check_output(
            ['git', 'diff', '--name-only', 'HEAD'],
            cwd=repo_root, text=True, stderr=subprocess.DEVNULL
        ).strip()
    except subprocess.CalledProcessError:
        # HEAD may not exist (fresh repo); try staged only
        output = subprocess.check_output(
            ['git', 'diff', '--cached', '--name-only'],
            cwd=repo_root, text=True, stderr=subprocess.DEVNULL
        ).strip()

    if not output:
        return []

    result = []
    for relpath in output.splitlines():
        filepath = os.path.normpath(os.path.join(repo_root, relpath))
        # Must be under src_dir
        if not filepath.startswith(src_dir_abs + os.sep):
            continue
        # Must have a recognised extension
        ext = os.path.splitext(filepath)[1]
        if ext not in EXTENSIONS:
            continue
        # Must not be in an excluded directory
        rel_to_src = os.path.relpath(filepath, src_dir_abs)
        top_dir = rel_to_src.split(os.sep)[0]
        if top_dir in EXCLUDE_DIRS:
            continue
        if os.path.isfile(filepath):
            result.append(filepath)

    return sorted(result)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    args = sys.argv[1:]
    check   = '--check' in args
    very_verbose = '--very-verbose' in args
    verbose = '--verbose' in args or very_verbose
    all_flag = '--all' in args
    positional = [a for a in args if not a.startswith('--')]

    if positional:
        src_dir = os.path.abspath(positional[0])
    else:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        src_dir = os.path.normpath(os.path.join(script_dir, '..', '..', 'src'))

    if all_flag:
        all_files = find_source_files(src_dir)
    else:
        all_files = find_changed_source_files(src_dir)

    if not all_files:
        print('No files to process.')
        return

    # --check: just report which headers need fixing (no clang-format run)
    if check:
        modified = 0
        for filepath in all_files:
            with open(filepath, 'r') as f:
                content = f.read()
            lines = content.splitlines()
            if not _is_header_file(lines):
                continue
            header_lines, rest_start = collect_header(lines)
            if not header_lines:
                continue
            entries = parse_entries(header_lines)
            if not entries:
                continue
            # Compare without guards
            new_header = rebuild_header(entries, with_guards=False)
            new_lines = new_header + lines[rest_start:]
            new_content = '\n'.join(new_lines)
            if content.endswith('\n'):
                new_content += '\n'
            if new_content != content:
                modified += 1
                rel = os.path.relpath(filepath, src_dir)
                print(f'  Would modify: {rel}')
            elif verbose:
                rel = os.path.relpath(filepath, src_dir)
                print(f'  Unchanged: {rel}')
        print(f'\nProcessed {len(all_files)} files, would modify {modified}')
        if modified > 0:
            sys.exit(1)
        return

    # --- Process each file: header + clang-format + strip guards in memory ---
    # Only writes to disk if the final result differs from the original.
    header_count = 0
    cf_count = 0
    cf_skipped = 0
    for filepath in all_files:
        with open(filepath, 'r') as f:
            original = f.read()

        # Step 1: format header + add temporary guards (in memory)
        guarded, header_changed = format_header_content(original)
        if header_changed:
            header_count += 1

        # Step 2: run clang-format (via stdin to avoid writing guarded content)
        result = subprocess.run(
            ['clang-format', '-style=file', '--assume-filename=' + filepath],
            input=guarded, capture_output=True, text=True
        )
        if result.returncode != 0:
            print(f'clang-format failed on {filepath} (exit {result.returncode}):')
            if result.stderr:
                print(result.stderr)
            sys.exit(result.returncode)

        # Step 3: strip temporary guards (in memory)
        final = strip_guards_content(result.stdout)

        # Only write if something actually changed
        if final != original:
            with open(filepath, 'w') as f:
                f.write(final)
            cf_count += 1
            rel = os.path.relpath(filepath, src_dir)
            print(f'  Formatted: {rel}')
        else:
            cf_skipped += 1

    scope = 'git-changed' if not all_flag else 'all'
    print(f'Done. {cf_count} files formatted, {scope} {cf_skipped} already correct.')


if __name__ == '__main__':
    main()
