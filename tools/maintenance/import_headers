"""Replace OpenAccel headers with ref-code headers.

For each source file in src/ (excluding solver/), finds the matching file in
ref-code by relative path and copies its header over.  Original headers are
saved to .header_backup.json so restore_headers can put them back.

Usage:
    import_headers <OTHER_PROJECT_DIR>

    OTHER_PROJECT_DIR  Root of the other codebase (parent of src/)
"""

import json
import os
import subprocess
import sys

EXTENSIONS = {'.c', '.cpp', '.C', '.h', '.hpp', '.H'}
EXTRA_NAMES = {'CMakeLists.txt'}
EXCLUDE_DIRS = {'solver'}


def extract_header(lines):
    """Extract header comment lines from top of file.

    Handles both ``//`` (C++) and ``#`` (CMake) comment styles.
    Strips clang-format guards if present.
    Returns (header_lines, rest_start_index).
    header_lines preserves original formatting (no stripping).
    """
    header = []
    i = 0

    # Strip UTF-8 BOM if present on first line
    if lines and lines[0].startswith('\ufeff'):
        lines = [lines[0].lstrip('\ufeff')] + lines[1:]

    if i < len(lines) and lines[i].strip() == '// clang-format off':
        i += 1

    # Detect comment prefix from first line
    if i < len(lines):
        s = lines[i].strip()
        if s.startswith('//'):
            prefix = '//'
        elif s.startswith('#'):
            prefix = '#'
        else:
            return header, i
    else:
        return header, i

    while i < len(lines):
        s = lines[i].strip()
        if s == '// clang-format on':
            i += 1
            break
        if not s.startswith(prefix):
            break
        header.append(lines[i])
        i += 1

    return header, i


def find_source_files(src_dir):
    """Return sorted list of (abs_path, rel_path) for source files, excluding solver."""
    result = []
    for root, dirs, files in os.walk(src_dir):
        rel = os.path.relpath(root, src_dir)
        dirs[:] = sorted(d for d in dirs if rel != '.' or d not in EXCLUDE_DIRS)
        for fname in sorted(files):
            ext = os.path.splitext(fname)[1]
            if ext in EXTENSIONS or fname in EXTRA_NAMES:
                abs_path = os.path.join(root, fname)
                rel_path = os.path.relpath(abs_path, src_dir)
                result.append((abs_path, rel_path))
    return result


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]

    script_dir = os.path.dirname(os.path.abspath(__file__))
    local_src = os.path.normpath(os.path.join(script_dir, '..', '..', 'src'))
    if not args:
        print('Usage: import_headers <OTHER_PROJECT_DIR>')
        print('  OTHER_PROJECT_DIR  Root of the other codebase (parent of src/)')
        sys.exit(1)

    accel_src = os.path.join(os.path.abspath(args[0]), 'src')

    if not os.path.isdir(accel_src):
        print(f'Error: src/ not found under: {args[0]}')
        sys.exit(1)

    backup_path = os.path.join(script_dir, '.header_backup.json')
    if os.path.exists(backup_path):
        print(f'Error: backup already exists at {backup_path}')
        print('Run restore_headers first, or delete the backup manually.')
        sys.exit(1)

    # Find git root for reading committed originals
    repo_root = os.path.normpath(os.path.join(script_dir, '..', '..'))

    local_files = find_source_files(local_src)
    backup = {}
    replaced = 0
    skipped = 0

    for local_path, rel_path in local_files:
        accel_path = os.path.join(accel_src, rel_path)
        if not os.path.isfile(accel_path):
            skipped += 1
            continue

        # Read the committed (git HEAD) version as the true original
        git_rel = os.path.join('src', rel_path)
        try:
            git_content = subprocess.run(
                ['git', 'show', f'HEAD:{git_rel}'],
                cwd=repo_root, capture_output=True, text=True, check=True,
            ).stdout
        except subprocess.CalledProcessError:
            skipped += 1
            continue

        git_lines = git_content.splitlines()
        git_header, _ = extract_header(git_lines)

        # Read working-tree file and other-project file
        with open(local_path, 'r') as f:
            local_content = f.read()
        with open(accel_path, 'r') as f:
            accel_content = f.read()

        local_lines = local_content.splitlines()
        accel_lines = accel_content.splitlines()

        _, local_rest = extract_header(local_lines)
        accel_header, _ = extract_header(accel_lines)

        if not git_header or not accel_header:
            skipped += 1
            continue

        # Save the committed original header for restore
        backup[rel_path] = git_header

        # Replace header in working tree
        new_lines = accel_header + local_lines[local_rest:]
        new_content = '\n'.join(new_lines)
        if local_content.endswith('\n'):
            new_content += '\n'

        with open(local_path, 'w') as f:
            f.write(new_content)
        replaced += 1

    # Save backup
    with open(backup_path, 'w') as f:
        json.dump(backup, f, indent=2)

    print(f'Replaced headers in {replaced} files ({skipped} skipped)')
    print(f'Backup saved to {backup_path}')


if __name__ == '__main__':
    main()
