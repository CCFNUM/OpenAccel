"""Restore original OpenAccel headers saved by import_headers.

Reads .header_backup.json, replaces current headers with the saved originals,
then removes the backup file.

Usage:
    restore_headers
"""

import json
import os
import sys


def extract_header(lines):
    """Extract header comment lines from top of file.

    Handles both ``//`` (C++) and ``#`` (CMake) comment styles.
    Strips clang-format guards if present.
    Returns (header_lines, rest_start_index).
    """
    header = []
    i = 0

    # Strip UTF-8 BOM if present on first line
    if lines and lines[0].startswith('\ufeff'):
        lines = [lines[0].lstrip('\ufeff')] + lines[1:]

    if i < len(lines) and lines[i].strip() == '// clang-format off':
        i += 1

    # Detect comment prefix from first line
    if i < len(lines):
        s = lines[i].strip()
        if s.startswith('//'):
            prefix = '//'
        elif s.startswith('#'):
            prefix = '#'
        else:
            return header, i
    else:
        return header, i

    while i < len(lines):
        s = lines[i].strip()
        if s == '// clang-format on':
            i += 1
            break
        if not s.startswith(prefix):
            break
        header.append(lines[i])
        i += 1

    return header, i


def main():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    local_src = os.path.normpath(os.path.join(script_dir, '..', '..', 'src'))
    backup_path = os.path.join(script_dir, '.header_backup.json')

    if not os.path.exists(backup_path):
        print('Error: no backup found. Nothing to restore.')
        print(f'Expected: {backup_path}')
        sys.exit(1)

    with open(backup_path, 'r') as f:
        backup = json.load(f)

    restored = 0
    missing = 0

    for rel_path, saved_header in backup.items():
        local_path = os.path.join(local_src, rel_path)
        if not os.path.isfile(local_path):
            print(f'  Warning: file no longer exists: {rel_path}')
            missing += 1
            continue

        with open(local_path, 'r') as f:
            content = f.read()

        lines = content.splitlines()
        _, rest_start = extract_header(lines)

        new_lines = saved_header + lines[rest_start:]
        new_content = '\n'.join(new_lines)
        if content.endswith('\n'):
            new_content += '\n'

        with open(local_path, 'w') as f:
            f.write(new_content)
        restored += 1

    os.remove(backup_path)
    print(f'Restored headers in {restored} files ({missing} missing)')
    print('Backup removed.')


if __name__ == '__main__':
    main()
